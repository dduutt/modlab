{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modlab",
  "version": "0.1.2",
  "identifier": "com.dt.modlab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "modlab",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNjFFNEU1NzdCMDQ4NEQKUldSTlNMQjM1ZVJoeXh4RklCekNXTiszS2ZvRFlGSnVGSUh6RzZYczVpWWQ2TTRhLzl0ejR5WFgK",
      "endpoints": [
        "https://update.dduu.cloud/dduutt/modlab/latest.json",
        "https://github.com/dduutt/modlab/releases/latest/download/latest.json"
      ]
    }
  }
}
